{
  "name": "@nativepi/extension-api",
  "version": "1.0.0",
  "description": "Typed, schema-validated graphical extension API for NativePi.",
  "author": "nonlooped",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./schema": "./src/schema.ts",
    "./ui": "./src/ui.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "nativepi",
    "pi-coding-agent",
    "extension",
    "react"
  ],
  "homepage": "https://github.com/nonlooped/nativepi/tree/main/packages/extension-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlooped/nativepi.git",
    "directory": "packages/extension-api"
  },
  "bugs": {
    "url": "https://github.com/nonlooped/nativepi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
