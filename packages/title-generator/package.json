  },
  "homepage": "https://github.com/nonlooped/nativepi/tree/main/packages/title-generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlooped/nativepi.git",
    "directory": "packages/title-generator"
  },
  "bugs": {
    "url": "https://github.com/nonlooped/nativepi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nativepi/extension-api": "workspace:^",
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.0"
  }
}
