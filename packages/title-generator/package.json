{
  "name": "@nativepi/title-generator",
  "version": "0.1.0",
  "description": "Generates concise chat titles in Pi, with a model picker in NativePi.",
  "author": "nonlooped",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "nativepi",
    "extension"
  ],
  "files": [
    "extensions",
    "renderer",
    "types.ts",
    "README.md"
  ],
  "scripts": {
