{
  "name": "@nativepi/mcp",
  "version": "1.0.0",
  "description": "Connects MCP servers and exposes their tools to Pi and NativePi.",
  "author": "nonlooped",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "nativepi",
    "extension",
    "mcp",
    "model-context-protocol"
  ],
  "files": [
    "extensions",
    "renderer",
    "types.ts",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./extensions/mcp.ts"
    ]
  },
  "nativepi": {
    "renderer": "./renderer/index.tsx"
  },
  "homepage": "https://github.com/nonlooped/nativepi/tree/main/packages/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlooped/nativepi.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/nonlooped/nativepi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nativepi/extension-api": "workspace:^",
    "@phosphor-icons/react": "^2.1.10",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
