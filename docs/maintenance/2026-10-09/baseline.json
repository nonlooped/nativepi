        "build": {
          "appId": "dev.nativepi.app",
          "productName": "NativePi",
          "executableName": "nativepi",
          "npmRebuild": false,
          "directories": {
            "output": "release"
          },
          "files": [
            "out/**/*",
            "resources/icon.png"
