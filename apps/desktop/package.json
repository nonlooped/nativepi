{
  "name": "@nativepi/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "A Windows-first desktop interface for the Pi coding agent.",
  "author": "nonlooped",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@lobehub/icons": "^5.15.0",
    "@nativepi/extension-api": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.2.12",
    "@streamdown/code": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tinykeys": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "dev.nativepi.app",
    "productName": "NativePi",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@earendil-works/**/*",
      "**/node_modules/esbuild/**/*",
      "**/node_modules/@esbuild/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
