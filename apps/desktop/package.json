{
  "name": "@nativepi/desktop",
  "private": true,
  "version": "1.17.0",
  "description": "A free, open-source desktop interface for the Pi coding agent on Windows, macOS, and Linux.",
  "author": "nonlooped",
  "keywords": [
    "nativepi",
    "pi-coding-agent",
    "coding-agent",
    "desktop",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "electron"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "bun scripts/prepare-node-pty.mjs",
    "dev": "bun scripts/prepare-node-pty.mjs && electron-vite dev",
    "build": "bun scripts/prepare-node-pty.mjs && electron-vite build",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && electron-builder",
    "test:unit": "bun run scripts/test-unit.ts",
    "test:dom": "bun run scripts/test-dom.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@shadcn/react": "^0.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "apca-w3": "^0.1.9",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "koffi": "^3.3.8",
    "node-pty": "^1.1.0",
    "npm": "^12.2.2",
    "parse5": "^8.1.1",
    "recharts": "3.10.1",
    "typebox": "1.3.27",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@nativepi/extension-api": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.6.4",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "21.0.4",
    "katex": "^0.19.1",
    "material-icon-theme": "^5.40.0",
    "mermaid": "^12.3.0",
    "node-gyp": "13.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.21.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tinykeys": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "dev.nativepi.app",
    "productName": "NativePi",
    "executableName": "nativepi",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/@earendil-works/**/*",
      "**/node_modules/esbuild/**/*",
      "**/node_modules/@esbuild/**/*",
      "**/node_modules/node-pty/**/*",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/koffi-*/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nonlooped",
        "repo": "nativepi"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "resources/installer-sidebar.bmp"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "resources/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    }
  }
}
