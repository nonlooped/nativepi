{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "vite/client", "@types/react", "@types/react-dom"],
    "paths": {
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["src", "electron.vite.config.ts"],
  "exclude": ["node_modules", "dist", "out", "release", "build"]
}
