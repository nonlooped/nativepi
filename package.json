{
  "name": "nativepi",
  "private": true,
  "version": "1.5.0",
  "description": "A free, open-source desktop interface for the Pi coding agent on Windows, macOS, and Linux.",
  "author": "nonlooped",
  "license": "MIT",
  "keywords": [
    "nativepi",
    "pi-coding-agent",
    "coding-agent",
    "desktop",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "electron",
    "open-source"
  ],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "cd apps/desktop && bun run install-electron",
    "dev": "cd apps/desktop && bun run dev",
    "build": "cd apps/desktop && bun run build",
    "pack": "cd apps/desktop && bun run pack",
    "dist": "cd apps/desktop && bun run dist",
    "dist:win": "cd apps/desktop && bun run dist:win",
    "dist:mac": "cd apps/desktop && bun run dist:mac",
    "dist:linux": "cd apps/desktop && bun run dist:linux",
    "typecheck": "cd apps/desktop && bun run typecheck",
    "typecheck:packages": "bun run --cwd packages/extension-api typecheck && bun run --cwd packages/mcp typecheck && bun run --cwd packages/meta typecheck && bun run --cwd packages/service-tier typecheck && bun run --cwd packages/subagents typecheck && bun run --cwd packages/subscription-usage typecheck && bun run --cwd packages/title-generator typecheck",
    "test": "bun test apps/desktop packages",
    "web:dev": "cd apps/web && bun run dev",
    "web:build": "cd apps/web && bun run build",
    "web:start": "cd apps/web && bun run start",
    "quality:fallow": "fallow",
    "quality:doctor": "react-doctor apps/desktop --yes --verbose",
    "preview": "cd apps/desktop && bun run preview"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "fallow": "^3.14.0",
    "react-doctor": "^0.9.4"
  }
}
