{
  "name": "nativepi",
  "private": true,
  "version": "1.14.0",
  "description": "A free, open-source desktop interface for the Pi coding agent on Windows, macOS, and Linux.",
  "author": "nonlooped",
  "license": "MIT",
  "keywords": [
    "nativepi",
    "pi-coding-agent",
    "coding-agent",
    "desktop",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "electron",
    "open-source"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "check": "bun run --filter '*' typecheck && bun run --cwd apps/web lint",
    "test": "bun test apps/desktop packages",
    "build": "bun run --filter '*' build",
    "package": "bun run --cwd apps/desktop package"
  },
  "overrides": {
    "katex": "0.19.0",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "shiki": "4.5.0"
  }
}
