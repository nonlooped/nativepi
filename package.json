{
  "name": "nativepi",
  "private": true,
  "version": "0.8.2",
  "description": "A Windows-first desktop interface for the Pi coding agent.",
  "author": "nonlooped",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "cd apps/desktop && bun run install-electron",
    "dev": "cd apps/desktop && bun run dev",
    "build": "cd apps/desktop && bun run build",
    "pack": "cd apps/desktop && bun run pack",
    "dist": "cd apps/desktop && bun run dist",
    "dist:win": "cd apps/desktop && bun run dist:win",
    "typecheck": "cd apps/desktop && bun run typecheck",
    "test": "cd apps/desktop && bun test",
    "web:dev": "cd apps/web && bun run dev",
    "web:build": "cd apps/web && bun run build",
    "web:start": "cd apps/web && bun run start",
    "quality:fallow": "fallow",
    "quality:doctor": "react-doctor apps/desktop --yes --verbose",
    "preview": "cd apps/desktop && bun run preview"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "fallow": "^3.9.1",
    "react-doctor": "^0.9.1"
  }
}
